# Unit test run on every push: main.mac with two slices of 1 s (about 400 000
# decays). Generated from main.mac: keep it in sync.
/pet/physicsList          G4EmStandardPhysics_option3
/pet/productionCut        1 mm
/pet/randomSeed           123456789
/pet/numberOfThreads      1
/pet/timeSlice            1 s
/pet/timeStop             2 s
